# Copy to backend/.env and adjust. Every setting is optional; the defaults
# below run the app with zero infrastructure (SQLite, local Ollama).
# Environment variables of the same name take precedence over this file.

# Database (async SQLAlchemy URL). Migrations run automatically on startup.
DATABASE_URL=sqlite+aiosqlite:///./soteria.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/soteria

# Local LLM for plain-English explanations (optional).
OLLAMA_URL=http://localhost:11434
# Any installed chat model: see `ollama list`.
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

# CORS origin of the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173

# Serve the built UI from the backend (single port). Empty = API only.
# STATIC_DIR=../frontend/dist

# CISA Known Exploited Vulnerabilities feed and how long to cache it (seconds).
# CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# KEV_CACHE_TTL=21600
